# Required
REPO_URL=https://github.com/your-org/your-repo.git
REPO_SLUG=your-org/your-repo
GH_TOKEN=ghp_your_github_personal_access_token
GIT_AUTHOR_NAME=Claude Agent
GIT_AUTHOR_EMAIL=claude-agent@your-org.com

# Path to your Claude credentials file
CLAUDE_CREDENTIALS_FILE=/path/to/.claude/.credentials.json

# Optional — defaults shown
BASE_BRANCH=main
PLANNER_POLL_INTERVAL_SECONDS=120
PLANNER_MAX_TURNS=30
EXECUTOR_ID=executor-01
EXECUTOR_POLL_INTERVAL_SECONDS=60
EXECUTOR_MAX_TURNS=50
VALIDATION_COMMAND=

# Commit signing (off | gpg | ssh)
GIT_COMMIT_SIGNING=off
GIT_SIGNING_KEY=
SIGNING_KEYS_PATH=./secrets
