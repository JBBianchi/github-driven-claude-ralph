# Required
REPO_URL=https://github.com/your-org/your-repo.git
REPO_SLUG=your-org/your-repo
GH_TOKEN=ghp_your_github_personal_access_token
GIT_AUTHOR_NAME=Claude Agent
GIT_AUTHOR_EMAIL=claude-agent@your-org.com

# Path to your Claude credentials file
CLAUDE_CREDENTIALS_FILE=/path/to/.claude/.credentials.json

# Optional defaults
BASE_BRANCH=main
PLANNER_POLL_INTERVAL_SECONDS=120
PLANNER_MAX_TURNS=50
EXECUTOR_ID=executor-01
EXECUTOR_POLL_INTERVAL_SECONDS=60
EXECUTOR_MAX_TURNS=100
VALIDATION_COMMAND=

# Commit signing (off | gpg | ssh)
GIT_COMMIT_SIGNING=off
GIT_SIGNING_KEY=
SIGNING_KEYS_PATH=./secrets

# RLM plugin integration (rand/rlm-claude-code)
RLM_PLUGIN_ENABLED=true
RLM_PLUGIN_REQUIRED=true
RLM_PLUGIN_REF=rlm-claude-code@rlm-claude-code
RLM_PLUGIN_KEY=rlm-claude-code@rlm-claude-code
RLM_PLUGIN_NAME=rlm-claude-code
RLM_PLUGIN_SCOPE=user
RLM_MARKETPLACE_SOURCE=rand/rlm-claude-code
RLM_PLUGIN_BUILD_HOOKS=true
RLM_PLUGIN_SYNC_REQUIRED=true
RLM_PLUGIN_VERIFY_REQUIRED=true
RLM_ACTIVATION_MODE=complexity
RLM_DEBUG=0
